#!/usr/bin/env python3
"""What Rocky's sub-agents (Claude Code sessions in terminals) have reported lately.
    tools/agents [n]   the last n events (default 10), newest last
"""
import os, sys
log = os.path.expanduser("~/desk-robot/workspace/journal/agents.log")
n = int(sys.argv[1]) if len(sys.argv) > 1 else 10
try:
    lines = open(log).read().splitlines()
except OSError:
    lines = []
if not lines:
    print("No reports from sub-agents yet.")
else:
    print("\n".join(lines[-n:]))
