# Copy to server/.env. One KEY=VALUE per line; blank means not set.

# What the robot calls you.
HUMAN_NAME=friend

# Any random string. The Mac app reads it from this file to connect as the robot's body.
ROBOT_TOKEN=

# Optional: Fish Audio key for a cloned voice (fish.audio). Without it the Mac's built-in voice is used.
FISH_AUDIO_API_KEY=

# Optional: TypeSafe key for the "was that said to me?" judgment while he is awake (typesafe.ai).
TYPESAFE_API_KEY=

# Where his memory lives (plain Markdown; put it in your Obsidian vault or iCloud Drive to sync it).
# Default: ~/desk-robot/workspace/memory
MEMORY_DIR=

# Optional: a notes folder (Obsidian vault or any folder) he may read, and write to only in the
# subfolders listed in server/brain/config.py (VAULT_WRITE_DIRS). Empty = no vault.
VAULT_PATH=

# Where long answers are written as notes. Default: ~/desk-robot/workspace/notes
NOTES_INBOX=

# Only when BRAIN = "api" in config.py (the upstream chat-API path instead of Claude Code).
LLM_API_KEY=
